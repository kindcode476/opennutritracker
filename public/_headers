# Response headers for the static site. Cloudflare Workers static assets reads
# this file at deploy time; it is not served to visitors.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()
  Content-Security-Policy: default-src 'none'; img-src 'self'; style-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/logo.svg
  Cache-Control: public, max-age=3600

/styles.css
  Cache-Control: public, max-age=3600
