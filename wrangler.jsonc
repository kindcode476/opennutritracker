// Cloudflare Workers deployment for the personal web build of the app.
//
// What deploys is `build/web` — the output of `flutter build web`, not a
// directory in the repository. Building it needs the Flutter SDK, which the
// Cloudflare build image does not have, so the deploy runs from GitHub
// Actions instead (.github/workflows/deploy-web.yml) and Cloudflare's own Git
// build should be switched off. Running `npx wrangler deploy` without
// building first will fail with "assets directory does not exist", which is
// the honest failure: there is nothing to deploy until Flutter has run.
//
// Everything under `web/` in the repository (the shell, icons, _headers,
// robots.txt, and the /about page) is copied into `build/web` by the build,
// so the deployed directory is self-contained.
//
// "name" must match the Worker the Cloudflare project is connected to, or the
// deploy will publish to a second Worker under this name instead.
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "opennutritracker",
  "compatibility_date": "2026-09-12",
  "assets": {
    "directory": "./build/web",
    // The app owns its routes: a deep link to /diary is the app's URL, not a
    // missing file, so unknown paths serve the app shell rather than a 404.
    // Real files — /about/, the icons, the engine — still win over this.
    "not_found_handling": "single-page-application"
  }
}
